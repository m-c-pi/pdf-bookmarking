{
  "manifest_version": 3,
  "name": "Superior Pdf Bookmarks",
  "description": "A free pdf bookmarking extension for chrome.",
  "version": "0.0.0.6",
  "icons": {
    "128": "icon-192x192.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon-192x192.png"
  },
  "permissions": ["activeTab", "tabs", "storage"]
}
